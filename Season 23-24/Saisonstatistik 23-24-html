<script>

/* =========================
   DATA
========================= */

const playerPoints={
    'Markus':[55,128,175,260,343,405,462,518,587,654,708,756,798,892,947,1006,1068,1147,1189,1245,1318,1388,1437,1512,1575,1655,1724,1814,1894,1960,2035,2094,2147,2224],
    'Erwin':[62,144,206,265,305,371,413,473,542,598,646,691,741,782,847,904,972,1037,1067,1131,1186,1252,1300,1380,1413,1490,1558,1621,1656,1705,1756,1797,1820],
    'Phil':[86,170,216,256,306,376,433,478,534,585,604,648,688,715,797,844,906,956,1011,1065,1115,1150,1204,1244,1300,1346,1361,1393,1427,1469,1540,1601,1634],
    'Didi':[70,157,189,216,250,292,313,358,420,469,509,551,593,646,724,790,881,934,965,1006,1043,1087,1135,1172,1252,1323,1372,1415,1483,1532,1592,1643,1647],
    'Steffo':[56,131,205,272,338,376,433,476,550,609,642,665,701,742,823,867,903,948,979,1036,1078,1126,1169,1215,1259,1320,1364,1398,1442,1483,1532,1566,1585],
    'Basti':[53,119,185,213,267,335,399,450,516,553,610,665,726,783,841,870,924,976,1025,1090,1163,1212,1267,1344,1410,1469,1515,1574,1626,1683,1729,1800,1862],
    'Eirik':[69,112,173,221,247,274,300,333,395,429,449,475,493,530,553,585,641,694,705,742,771,807,854,926,976,1052,1083,1124,1185,1220,1253,1302,1351],
    'Emil':[60,173,230,290,332,385,412,441,498,535,595,642,678,725,776,828,906,991,1079,1140,1210,1264,1320,1362,1413,1479,1517,1583,1658,1718,1814,1879,1926],
    'Kempka':[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],
    'Espen':[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],
    'Alex':[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null]
};

const players=Object.keys(playerPoints);

const colors=[
    '#E41A1C',
    '#377EB8',
    '#4DAF4A',
    '#984EA3',
    '#FF7F00',
    '#A65628',
    '#F781BF',
    '#999999',
    '#66C2A5',
    '#FFD92F',
    '#FFFFFF'
];

const colorMap=Object.fromEntries(
    players.map((p,i)=>[p,colors[i]])
);

const TOTAL_MDS=34;

const labels=Array.from(
    {length:TOTAL_MDS},
    (_,i)=>i+1
);

const played=Math.max(
    ...players.map(
        p=>playerPoints[p].length
    )
);


/* =========================
   DATA CALCULATIONS
========================= */

function mdPoints(arr){

    return Array.from(
        {length:TOTAL_MDS},
        (_,i)=>
            i<arr.length
            ?
            (
                i
                ?
                arr[i]-arr[i-1]
                :
                arr[0]
            )
            :
            null
    );

}


function cumulativeForChart(arr){

    return Array.from(
        {length:TOTAL_MDS},
        (_,i)=>
            i<arr.length
            ?
            arr[i]
            :
            null
    );

}


function leaguePos(data){

    const out={};

    players.forEach(
        p=>out[p]=[]
    );

    for(let i=0;i<TOTAL_MDS;i++){

        if(i>=played){

            players.forEach(
                p=>out[p].push(null)
            );

            continue;
        }

        const ranked=
            players
            .filter(
                p=>i<data[p].length
            )
            .map(
                p=>({
                    p,
                    pts:data[p][i]
                })
            )
            .sort(
                (a,b)=>b.pts-a.pts
            );

        ranked.forEach(
            (x,r)=>
                out[x.p].push(r+1)
        );

        players
        .filter(
            p=>i>=data[p].length
        )
        .forEach(
            p=>out[p].push(null)
        );

    }

    return out;

}


function mdRank(data){

    const out={};

    players.forEach(
        p=>out[p]=[]
    );

    for(let i=0;i<TOTAL_MDS;i++){

        if(i>=played){

            players.forEach(
                p=>out[p].push(null)
            );

            continue;
        }

        const ranked=
            players
            .filter(
                p=>i<data[p].length
            )
            .map(
                p=>({
                    p,
                    pts:
                        i
                        ?
                        data[p][i]-data[p][i-1]
                        :
                        data[p][0]
                })
            )
            .sort(
                (a,b)=>b.pts-a.pts
            );

        ranked.forEach(
            (x,r)=>
                out[x.p].push(r+1)
        );

        players
        .filter(
            p=>i>=data[p].length
        )
        .forEach(
            p=>out[p].push(null)
        );

    }

    return out;

}


const cumulative=
    Object.fromEntries(
        players.map(
            p=>[
                p,
                cumulativeForChart(
                    playerPoints[p]
                )
            ]
        )
    );


const md=
    Object.fromEntries(
        players.map(
            p=>[
                p,
                mdPoints(
                    playerPoints[p]
                )
            ]
        )
    );


const league=
    leaguePos(playerPoints);

const rank=
    mdRank(playerPoints);


const avgMd=
    Array.from(
        {length:TOTAL_MDS},
        (_,i)=>{

            if(i>=played)
                return null;

            const vals=
                players
                .map(
                    p=>md[p][i]
                )
                .filter(
                    v=>
