function showInteractiveTooltip(
    html,
    mdNumber,
    chart,
    model
){

    interactiveTooltip.innerHTML=html;

    interactiveTooltip.classList.add(
        'visible'
    );

    const canvas=
        chart.canvas;

    const rect=
        canvas.getBoundingClientRect();

    const x=
        rect.left+
        model.caretX;

    const y=
        rect.top+
        model.caretY;

    const tw=
        interactiveTooltip.offsetWidth;

    const th=
        interactiveTooltip.offsetHeight;

    const gap=76;

    let left=
        mdNumber<=17
        ?
        x+gap
        :
        x-gap-tw;

    let top=
        y-th/2;

    left=
        Math.max(
            4,
            Math.min(
                left,
                window.innerWidth-tw-4
            )
        );

    top=
        Math.max(
            4,
            Math.min(
                top,
                window.innerHeight-th-4
            )
        );

    interactiveTooltip.style.left=
        left+'px';

    interactiveTooltip.style.top=
        top+'px';

}


function hideInteractiveTooltip(){

    interactiveTooltip.classList.remove(
        'visible'
    );

}


