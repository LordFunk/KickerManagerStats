   RESPONSIVE UPDATE
========================= */

window.addEventListener(
    'resize',
    ()=>{

        if(!c1)
            return;


        const mobile=
            isMobile();


        c1.data.datasets.forEach(
            ds=>{

                ds.pointRadius=
                    selectedPlayers.has(
                        ds.label
                    )
                    ?
                    6
                    :
                    (
                        mobile
                        ?
                        2
                        :
                        4
                    );


                ds.pointHoverRadius=
                    selectedPlayers.has(
                        ds.label
                    )
                    ?
                    7
                    :
                    (
                        mobile
                        ?
                        4
                        :
                        6
                    );

            }
        );


        c1.options.scales.x.ticks.maxTicksLimit=
            mobile
            ?
            10
            :
            34;

        c1.options.scales.x.ticks.autoSkip=
            false;

        c1.options.scales.x.title.display=
            !mobile;

        c1.options.scales.x.ticks.font.size=
            mobile
            ?
            9
            :
            11;

        c1.options.scales.y.ticks.font.size=
            mobile
            ?
            9
            :
            11;


        c1.update();

        /*
         * Reapply the rank-chart settings after
         * resizing. This is important because Chart.js
         * recalculates the chart dimensions on phones.
         */
        [c3,c4].forEach(chart=>{

            chart.options.scales.y.min=0.5;
            chart.options.scales.y.max=11.5;
            chart.options.scales.y.reverse=true;

            chart.options.scales.y.ticks.stepSize=1;
            chart.options.scales.y.ticks.precision=0;
            chart.options.scales.y.ticks.autoSkip=false;
            chart.options.scales.y.ticks.includeBounds=false;
            chart.options.scales.y.ticks.padding=5;

            chart.options.scales.y.ticks.font.size=
                mobile
                ?
                9
                :
                11;

            chart.options.scales.y.ticks.callback=
                function(value){

                    if(
                        Number.isInteger(value) &&
                        value>=1 &&
                        value<=11
                    ){
                        return value;
                    }

                    return '';
                };

            chart.options.elements.line.clip=false;
            chart.options.elements.point.clip=false;

            chart.update();

        });

        updateC1Fade();

    }
);

</script>

