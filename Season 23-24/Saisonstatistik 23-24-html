}


function rueckTable(
    title,
    data
){

    const w=
        document.createElement(
            'div'
        );

    w.className=
        'table-block';


    const rueckLabel=
        played>hinEnd
        ?
        `${hinEnd+1}–${played}`
        :
        '—';


    let html=`

        <div class="table-title">

            ${title}

            <span
                style="
                    font-size:.72rem;
                    font-weight:400;
                    color:#666
                "
            >
                (Spieltag ${rueckLabel})
            </span>

        </div>


        <table>

            <thead>

                <tr>

                    <th>Rang</th>
                    <th>Spieler</th>
                    <th>Punkte</th>

                    <th
                        title="
                            Rückrunde MD 1–${rueckPlayed}
                            vs.
                            Hinrunde MD 1–${rueckPlayed}
                        "
                    >
                        Diff*
                    </th>

                </tr>

            </thead>

            <tbody>

    `;


    const rueckStarted=
        played>hinEnd;


    data.forEach(
        (d,i)=>{

            const first=
                i===0;

            let diffCell;


            if(!rueckStarted){

                diffCell=
                    '<td class="diff-zero">—</td>';

            }else{

                const diff=
                    d.diff;

                let cls;
                let str;


                if(diff>0){

                    cls='diff-pos';
                    str='+'+diff;

                }else if(diff<0){

                    cls='diff-neg';
                    str=''+diff;

                }else{

                    cls='diff-zero';
                    str='±0';

                }


                diffCell=`

                    <td class="${cls}">
                        ${str}
                    </td>

                `;

            }


            html+=`

                <tr
                    class="${first?'rank-1':''}"
                >

                    <td>

                        <span
                            class="${
                                first
                                ?
                                'rank-badge gold'
                                :
                                'rank-badge'
                            }"
                        >
                            ${i+1}
                        </span>

                    </td>

                    <td>
                        ${playerNameCell(d.name)}
                    </td>

                    <td>
                        ${d.pts}
                    </td>

                    ${diffCell}

                </tr>

            `;

        }
    );


    html+=`

            </tbody>

        </table>

    `;


    if(rueckStarted){

        html+=`

            <p
                style="
                    font-size:.7rem;
                    color:#555;
                    margin:6px 4px 0;
                    text-align:center
                "
            >
                * Rück MD 18–${played}
                vs.
                Hin MD 1–${rueckPlayed}
            </p>

        `;

    }


    w.innerHTML=html;

    return w;

}


tablesWrapper.appendChild(
    hinTable(
        'Hinrunde',
        hin
    )
);


tablesWrapper.appendChild(
    rueckTable(
        'Rückrunde',
        rueck
    )
);


