/* =========================
   INTEGER RANK AXES
========================= */

/*
 * The chart scale runs from 0.5 to 11.5.
 * This gives rank 1 and rank 11 physical space
 * inside the chart so their lines and points cannot
 * be clipped.
 *
 * The callback hides 0.5 and 11.5, so the user sees
 * only the actual positions 1 through 11.
 *
 * autoSkip:false ensures all 11 positions are shown,
 * including on mobile.
 */

[c3,c4].forEach(chart=>{

    chart.options.scales.y.min=0.5;
    chart.options.scales.y.max=11.5;

    chart.options.scales.y.reverse=true;

    chart.options.scales.y.ticks={
        color:'#777',
        stepSize:1,
        precision:0,
        autoSkip:false,
        includeBounds:false,
        padding:5,

        font:{
            size:
                isMobile()
                ?
                9
                :
                11
        },

        callback:function(value){

            if(
                Number.isInteger(value) &&
                value>=1 &&
                value<=11
            ){
                return value;
            }

            return '';
        }

    };

    chart.options.scales.y.grid={
        color:'rgba(255,255,255,.06)',
        drawTicks:true
    };

    /*
     * Prevent Chart.js from clipping line segments
     * and points at the chart boundaries.
     */
    chart.options.elements.line.clip=false;
    chart.options.elements.point.clip=false;

    chart.update();

});


