<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Season 23-24 | Kicker Stats</title>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

:root{
    --bg:#050505;
    --card:#101010;
    --card2:#151515;
    --line:rgba(255,255,255,.09);
    --text:#f5f5f5;
    --muted:#858585;
    --red:#e30613;
    --red-dark:#a9000b;
    --grid:rgba(255,255,255,.07);
}

*,
*::before,
*::after{
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    margin:0;
    padding:0;
    background:var(--bg);
    color:var(--text);
    font-family:'Segoe UI',Roboto,Arial,sans-serif;
    line-height:1.5;
    min-height:100vh;
}

/* =========================
   NAVIGATION
========================= */

.nav{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:64px;
    background:rgba(5,5,5,.92);
    backdrop-filter:blur(12px);
    border-bottom:1px solid var(--line);
    z-index:1000;
}

.nav-inner{
    max-width:1400px;
    height:100%;
    margin:auto;
    padding:0 30px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    color:white;
    text-decoration:none;
    font-size:18px;
    font-weight:700;
    letter-spacing:.5px;
}

.logo span{
    color:var(--red);
}

.nav-links{
    display:flex;
    gap:28px;
}

.nav-links a{
    color:#aaa;
    text-decoration:none;
    font-size:14px;
    transition:.2s;
}

.nav-links a:hover{
    color:white;
}

/* =========================
   PAGE HEADER
========================= */

.page-header{
    max-width:1400px;
    margin:0 auto;
    padding:145px 30px 65px;
    position:relative;
    text-align:left;
}

.page-label{
    color:var(--red);
    font-size:13px;
    font-weight:700;
    letter-spacing:3px;
    text-transform:uppercase;
    margin-bottom:16px;
}

h1{
    margin:0;
    font-size:clamp(42px,6vw,72px);
    line-height:.95;
    letter-spacing:-3px;
    font-weight:800;
}

h1 span{
    color:var(--red);
}

.page-description{
    margin:24px 0 0;
    color:var(--muted);
    font-size:15px;
    max-width:650px;
}

/* =========================
   MAIN CONTENT
========================= */

main{
    max-width:1400px;
    margin:0 auto;
    padding:0 30px 80px;
}

.section-label{
    display:flex;
    align-items:center;
    gap:18px;
    width:100%;
    margin:35px 0 18px;
    color:var(--red);
    font-size:12px;
    font-weight:700;
    letter-spacing:2px;
    text-transform:uppercase;
}

.section-label::after{
    content:"";
    height:1px;
    background:var(--line);
    flex:1;
}

/* =========================
   CHART CARDS
========================= */

.chart-container{
    width:100%;
    background:
        linear-gradient(
            145deg,
            var(--card),
            var(--card2)
        );
    border:1px solid var(--line);
    border-radius:12px;
    box-shadow:none;
    padding:20px 20px 16px;
    margin-bottom:18px;
    aspect-ratio:2.4/1;
    min-height:280px;
    max-height:520px;
    position:relative;
    overflow:hidden;
}

.chart-container::before{
    content:"";
    position:absolute;
    width:250px;
    height:250px;
    right:-130px;
    top:-130px;
    border-radius:50%;
    background:rgba(227,6,19,.045);
    pointer-events:none;
}

.chart-container.interactive{
    padding-bottom:8px;
    margin-bottom:10px;
}

.chart-container.interactive .chart-inner{
    height:100%;
    position:relative;
}

.chart-container.interactive canvas{
    width:100%!important;
    height:100%!important;
}

/* =========================
   RANK CHARTS
========================= */

.rank-chart{
    min-height:420px;
}

.rank-chart canvas{
    width:100%!important;
    height:100%!important;
}

/* =========================
   CHART TOOLTIP
========================= */

.tooltip-custom{
    position:fixed;
    z-index:1000;
    pointer-events:none;
    background:#111;
    color:#f5f5f5;
    border:1px solid rgba(255,255,255,.12);
    border-radius:8px;
    box-shadow:0 8px 25px rgba(0,0,0,.5);
    padding:9px 11px;
    font-size:.78rem;
    line-height:1.5;
    white-space:nowrap;
    opacity:0;
    transition:opacity .08s ease;
}

.tooltip-custom.visible{
    opacity:1;
}

.tooltip-title{
    font-weight:700;
    color:#aaa;
    margin-bottom:3px;
}

.tooltip-row{
    display:flex;
    align-items:center;
    gap:6px;
}

.tooltip-dot{
    width:8px;
    height:8px;
    border-radius:50%;
    flex-shrink:0;
}

/* =========================
   INTERACTIVE CONTROLS
========================= */

.interactive-controls{
    width:100%;
    background:
        linear-gradient(
            145deg,
            var(--card),
            var(--card2)
        );
    border:1px solid var(--line);
    border-radius:10px;
    box-shadow:none;
    padding:14px 16px 10px;
    margin-bottom:18px;
}

.controls-top{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:8px;
}

.range-label{
    font-size:.82rem;
    color:#888;
}

.range-label strong{
    color:#f5f5f5;
}

.reset-btn{
    border:1px solid rgba(255,255,255,.12);
    background:#151515;
    color:#aaa;
    border-radius:6px;
    padding:5px 10px;
    font-size:.75rem;
    cursor:pointer;
    transition:.2s;
}

.reset-btn:hover{
    background:#1c1c1c;
    border-color:rgba(227,6,19,.45);
    color:white;
}

.range-slider{
    position:relative;
    height:24px;
}

.slider-track,
.slider-range{
    position:absolute;
    top:10px;
    height:4px;
    border-radius:4px;
}

.slider-track{
    left:0;
    right:0;
    background:#292929;
}

.slider-range{
    background:var(--red);
}

.range-slider input{
    position:absolute;
    left:0;
    top:0;
    width:100%;
    height:24px;
    margin:0;
    background:none;
    pointer-events:none;
    appearance:none;
}

.range-slider input::-webkit-slider-thumb{
    appearance:none;
    width:17px;
    height:17px;
    border-radius:50%;
    background:var(--red);
    border:2px solid #111;
    box-shadow:0 1px 5px rgba(0,0,0,.6);
    cursor:pointer;
    pointer-events:auto;
}

.range-slider input::-moz-range-thumb{
    width:17px;
    height:17px;
    border:2px solid #111;
    border-radius:50%;
    background:var(--red);
    box-shadow:0 1px 5px rgba(0,0,0,.6);
    cursor:pointer;
    pointer-events:auto;
}

.slider-ticks{
    display:flex;
    justify-content:space-between;
    font-size:.65rem;
    color:#666;
    margin-top:1px;
}

/* =========================
   RANGE TABLE
========================= */

.range-table-wrapper{
    width:100%;
    margin:0 0 35px;
}

.range-table-title{
    text-align:left;
    color:#aaa;
    font-weight:700;
    font-size:13px;
    letter-spacing:.5px;
    margin:0 0 9px;
}

/* =========================
   TABLES
========================= */

.tables-wrapper{
    display:flex;
    width:100%;
    justify-content:space-between;
    gap:18px;
    flex-wrap:wrap;
    margin-bottom:35px;
    margin-top:12px;
}

.table-block{
    width:calc(50% - 9px);
}

.table-title{
    text-align:left;
    font-weight:700;
    margin-bottom:10px;
    font-size:16px;
    color:#f5f5f5;
}

table{
    width:100%;
    border-collapse:collapse;
    background:
        linear-gradient(
            145deg,
            var(--card),
            var(--card2)
        );
    border:1px solid var(--line);
    border-radius:12px;
    overflow:hidden;
    box-shadow:none;
}

thead tr{
    background:#181818;
}

th{
    padding:10px;
    text-align:center;
    font-size:.7rem;
    font-weight:600;
    text-transform:uppercase;
    letter-spacing:.06em;
    color:#777;
    border-bottom:1px solid var(--line);
}

td{
    padding:9px 10px;
    text-align:center;
    border-bottom:1px solid rgba(255,255,255,.055);
    font-size:.875rem;
    color:#ddd;
}

tbody tr:nth-child(even) td{
    background:rgba(255,255,255,.015);
}

tbody tr:hover td{
    background:rgba(227,6,19,.035);
}

tbody tr:last-child td{
    border-bottom:none;
}

tbody tr.rank-1 td{
    background:rgba(227,6,19,.055)!important;
}

.rank-badge{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:22px;
    height:22px;
    border-radius:50%;
    font-size:.75rem;
    font-weight:700;
    background:#252525;
    color:#aaa;
}

.rank-badge.gold{
    background:var(--red);
    color:white;
}

.player-cell{
    display:flex;
    align-items:center;
    gap:7px;
    justify-content:flex-start;
    padding-left:4px;
}

.player-dot{
    width:9px;
    height:9px;
    border-radius:50%;
    flex-shrink:0;
}

.diff-pos{
    color:#55c96a;
    font-weight:700;
}

.diff-neg{
    color:#ff4d4d;
    font-weight:700;
}

.diff-zero{
    color:#888;
    font-weight:700;
}

/* =========================
   CHART.JS DARK THEME
========================= */

.chart-container canvas{
    position:relative;
    z-index:2;
}

/* =========================
   FOOTER
========================= */

footer{
    border-top:1px solid var(--line);
    padding:35px 30px;
    text-align:center;
    color:#555;
    font-size:12px;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:700px){

    .nav{
        height:auto;
    }

    .nav-inner{
        padding:14px 20px;
        flex-direction:column;
        gap:10px;
    }

    .nav-links{
        gap:15px;
        flex-wrap:wrap;
        justify-content:center;
    }

    .page-header{
        padding:150px 20px 50px;
    }

    h1{
        font-size:48px;
        letter-spacing:-3px;
    }

    main{
        padding-left:20px;
        padding-right:20px;
    }

    .chart-container{
        width:100%;
        aspect-ratio:unset;
        height:52vw;
        min-height:220px;
        max-height:320px;
        padding:12px 10px 10px;
        margin-bottom:14px;
        border-radius:10px;
    }

    /*
     * The rank charts contain 11 separate rank levels.
     * They need substantially more vertical room on phones
     * so Chart.js can display every level from 1 to 11.
     */
    .chart-container.rank-chart{
        height:460px;
        min-height:460px;
        max-height:none;
        padding:12px 10px 12px;
    }

    .interactive-controls{
        width:100%;
        padding:10px 11px 8px;
        margin-bottom:16px;
    }

    .range-label{
        font-size:.75rem;
    }

    .reset-btn{
        font-size:.7rem;
        padding:4px 8px;
    }

    .range-table-wrapper{
        width:100%;
    }

    .tables-wrapper{
        width:100%;
        flex-direction:column;
        gap:14px;
    }

    .table-block{
        width:100%;
    }

    .table-title{
        font-size:.9rem;
    }

    th{
        font-size:.62rem;
        padding:7px 6px;
    }

    td{
        font-size:.8rem;
        padding:6px;
    }

    .player-dot{
        width:8px;
        height:8px;
    }

    .rank-badge{
        width:19px;
        height:19px;
        font-size:.68rem;
    }

    .tooltip-custom{
        font-size:.7rem;
        padding:7px 8px;
    }

    .section-label{
        font-size:11px;
    }

}

/*
 * Landscape phones have less vertical space.
 * Keep the rank charts tall enough for all 11 ranks,
 * but slightly shorter than portrait mode.
 */
@media(max-width:900px) and (orientation:landscape){

    .chart-container.rank-chart{
        height:400px;
        min-height:400px;
        max-height:none;
    }

}

/*
 * Very small portrait screens.
 * Still keep enough room for all 11 rank levels.
 */
@media(max-width:400px){

    .chart-container.rank-chart{
        height:480px;
        min-height:480px;
    }

}

/*
 * Desktop rank charts also get enough room that
 * rank 1 and rank 11 are never pressed against
 * the chart boundaries.
 */
@media(min-width:701px){

    .chart-container.rank-chart{
        min-height:420px;
    }

}

</style>
</head>

