        );

    w.className=
        'table-block';


    let html=`

        <div class="table-title">

            ${title}

            <span
                style="
                    font-size:.72rem;
                    font-weight:400;
                    color:#666
                "
            >
                (Spieltag 1–${hinEnd})
            </span>

        </div>

        <table>

            <thead>

                <tr>

                    <th>Rang</th>
                    <th>Spieler</th>
                    <th>Punkte</th>

                </tr>

            </thead>

            <tbody>

    `;


    data.forEach(
        (d,i)=>{

            const first=
