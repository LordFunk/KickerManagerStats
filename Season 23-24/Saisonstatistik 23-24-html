========================= */

const hinEnd=
    Math.min(17,played);

const rueckStart=17;

const rueckEnd=
    played-1;


function segmentPts(
    arr,
    startIdx,
    endIdx
){

    if(
        startIdx > arr.length - 1
    ){
        return 0;
    }

    const end =
        Math.min(
            endIdx,
            arr.length - 1
        );

    return arr[end] -
        (
            startIdx > 0
            ?
            arr[startIdx - 1]
            :
            0
        );
}


const rueckPlayed=
    Math.max(
        0,
        played-hinEnd
    );


const hinPtsMap={};
const rueckPtsMap={};
const hinEquivPtsMap={};


players.forEach(p=>{

    hinPtsMap[p]=
        segmentPts(
            playerPoints[p],
            0,
            hinEnd-1
        );

    rueckPtsMap[p]=
        segmentPts(
            playerPoints[p],
            rueckStart,
            rueckEnd
        );

    hinEquivPtsMap[p]=
        segmentPts(
            playerPoints[p],
            0,
            rueckPlayed-1
        );

});


const hin=
    players
    .map(
        p=>({
            name:p,
            pts:hinPtsMap[p]
        })
    )
    .sort(
        (a,b)=>b.pts-a.pts
